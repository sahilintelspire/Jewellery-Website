# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Selection: 'sqlite' (zero-config local file) or 'mysql' (MySQL 8.0 / Coolify production)
DB_CLIENT=sqlite

# MySQL Credentials (set DB_CLIENT=mysql to use MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aura_jewels

# Auth & Admin Seed
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_NAME=Aura Studio Admin
ADMIN_EMAIL=admin@aurajewels.in
ADMIN_PASSWORD=AuraStudio@2026

# Google OAuth (optional — paste Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Razorpay Keys (paste your activated Key ID & Secret from Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email / Nodemailer SMTP (optional — leave blank for local preview mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AURA JEWELS Studio <hello@aurajewels.in>"
